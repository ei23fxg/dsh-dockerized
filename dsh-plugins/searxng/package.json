{
  "name": "dsh-web-search-searxng",
  "version": "0.2.0",
  "description": "SearXNG-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "license": "MIT"
}
